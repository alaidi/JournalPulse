msgid "plugins.themes.journalMetrics.name"
msgstr "Journal Metrics Theme"

msgid "plugins.themes.journalMetrics.description"
msgstr "A child theme of the default theme. Numbers-first home page with usage statistics, the editorial workflow and the full list of the latest issue; usage block on article pages; canonical links and schema.org markup for search engines."

msgid "plugins.themes.journalMetrics.option.accent.label"
msgstr "Accent colour"

msgid "plugins.themes.journalMetrics.option.accent.description"
msgstr "Colour of buttons, numbers and bars. Use a dark shade so that white text on it stays readable."


msgid "plugins.themes.journalPulse.name"
msgstr "Journal Pulse Theme"

msgid "plugins.themes.journalPulse.description"
msgstr "A child theme of the default theme. Numbers-first home page with usage statistics, the editorial workflow and the full list of the latest issue; usage block on article pages; canonical links and schema.org markup for search engines."

msgid "plugins.themes.journalPulse.option.accent.label"
msgstr "Accent colour"

msgid "plugins.themes.journalPulse.option.accent.description"
msgstr "Colour of buttons, numbers and bars. Use a dark shade so that white text on it stays readable."

msgid "plugins.themes.journalPulse.option.tagline.label"
msgstr "Home page tagline"

msgid "plugins.themes.journalPulse.option.tagline.description"
msgstr "Optional second part of the home page title, printed in the accent colour after the journal name."

msgid "plugins.themes.journalPulse.option.heroStats.label"
msgstr "Usage numbers"

msgid "plugins.themes.journalPulse.option.heroStats.option"
msgstr "Show article, view and PDF counters of the current issue on the home page."

msgid "plugins.themes.journalPulse.option.heroLayout.label"
msgstr "Home page cover position"

msgid "plugins.themes.journalPulse.option.heroLayout.coverUnder"
msgstr "Cover under the journal name, usage numbers beside it"

msgid "plugins.themes.journalPulse.option.heroLayout.coverBeside"
msgstr "Usage numbers under the journal name, cover beside them"

msgid "plugins.themes.journalPulse.option.heroCoverSize.label"
msgstr "Home page cover size"

msgid "plugins.themes.journalPulse.option.heroCoverSize.normal"
msgstr "Normal (up to 320 px tall)"

msgid "plugins.themes.journalPulse.option.heroCoverSize.large"
msgstr "Large (up to 480 px tall)"


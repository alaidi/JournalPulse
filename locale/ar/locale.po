msgid "plugins.themes.journalMetrics.name"
msgstr "قالب Journal Metrics"

msgid "plugins.themes.journalMetrics.description"
msgstr "قالب فرعي مبني على القالب الافتراضي. صفحة رئيسية تتصدّرها الأرقام مع إحصاءات الاستخدام وسير العمل التحريري والقائمة الكاملة لآخر عدد؛ وكتلة الاستخدام في صفحات المقالات؛ وروابط canonical وترميز schema.org لمحركات البحث."


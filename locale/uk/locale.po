msgid "plugins.themes.journalMetrics.name"
msgstr "Тема Journal Pulse"

msgid "plugins.themes.journalMetrics.description"
msgstr "Дочірня тема до теми за замовчуванням. Головна сторінка з акцентом на цифри: статистика переглядів, етапи редакційного процесу та повний список статей останнього випуску; блок використання на сторінці статті; canonical-посилання та розмітка schema.org для пошукових систем."

msgid "plugins.themes.journalMetrics.option.accent.label"
msgstr "Акцентний колір"

msgid "plugins.themes.journalMetrics.option.accent.description"
msgstr "Колір кнопок, цифр і стовпчиків. Обирайте темний відтінок, щоб білий текст на ньому залишався читабельним."

msgid "plugins.themes.journalMetrics.option.tagline.label"
msgstr "Слоган на головній сторінці"

msgid "plugins.themes.journalMetrics.option.tagline.description"
msgstr "Необов'язкова друга частина заголовка головної сторінки; виводиться акцентним кольором після назви журналу."

msgid "plugins.themes.journalMetrics.option.heroStats.label"
msgstr "Показники використання"

msgid "plugins.themes.journalMetrics.option.heroStats.option"
msgstr "Показувати на головній сторінці кількість статей, переглядів і переглядів PDF поточного випуску."

msgid "plugins.themes.journalMetrics.option.workflow.label"
msgstr "Редакційний процес"

msgid "plugins.themes.journalMetrics.option.workflow.option"
msgstr "Показувати на головній сторінці смугу з етапами редакційного процесу та їх максимальною тривалістю."

